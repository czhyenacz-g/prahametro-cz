# Golemio v3 Parking API (https://api.golemio.cz) — server-only, nikdy
# se neposílá klientovi. Bez tokenu je build-time import (scripts/
# import-park-and-ride.ts) a živá obsazenost (app/api/park-and-ride/route.ts)
# nefunkční, ale appka NESPADNE — sekce P+R se prostě nezobrazí (viz
# CLAUDE.md a docs/PARKING.md). Zaregistruj zdarma na api.golemio.cz/api-keys.
GOLEMIO_API_KEY=

# Universal Content API (https://content-api.darbujan.com) — server-only,
# nikdy se neposílá klientovi. Napájí reklamní/promo sekci (viz
# lib/promotions/, docs/PROMOTIONS.md): reklamy se dnes spravují výhradně
# přes content-api.darbujan.com/admin/promotions, ne v tomto repozitáři.
# Bez těchto proměnných appka NESPADNE — reklamní karta se prostě
# nezobrazí (fallback na svátkové přání v češtině, jinak nic).
UCA_BASE_URL=
UCA_PROJECT_SLUG=
UCA_API_TOKEN=
